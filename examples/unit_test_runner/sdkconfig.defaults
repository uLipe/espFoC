CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# The ident kernels are gated off in the component default, but their unit
# tests must link.
CONFIG_ESP_FOC_ENABLE_MOTOR_ID=y
# Phase map discovery times its probe pulses in 1 ms sleeps.
CONFIG_FREERTOS_HZ=1000
# The sensorless stack's tests run it against a mock PMSM.
CONFIG_ESP_FOC_STACK_SENSORLESS=y
# Two instances so the per-axis isolation test runs.
CONFIG_ESP_FOC_SL_MAX_AXES=2
