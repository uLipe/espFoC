menu "espFoC Settings"

    config ESP_FOC_MAX_INVERTERS
        int "Max inverter driver instances (static pool)"
        range 1 2
        default 1

    config ESP_FOC_MAX_ROTOR_SENSORS
        int "Max rotor sensor instances (static pool)"
        range 1 2
        default 1

    config ESP_FOC_ROTOR_HALL
        bool "Hall-effect rotor sensor driver"
        default y
        help
            Electrical rotor angle from three 60-degree hall lines, made
            continuous by the common-layer angle estimator.

            Init order: create the inverter before this sensor. Both use ETM,
            and the inverter's bring-up resets the peripheral, which clears
            every channel including this driver's. This driver only enables the
            ETM bus clock and never resets, so inverter-then-hall needs no
            coordination. The sensor detects the reverse order at init and
            refuses when its require_etm_ready config field is set.

    config ESP_FOC_MAX_MUTEXES
        int "Max OSAL mutex instances (static pool)"
        range 1 8
        default 2

    config ESP_FOC_PWM_RATE_HZ
        int "Default PWM carrier frequency [Hz]"
        range 5000 40000
        default 20000

    config ESP_FOC_TRACE_ENABLE
        bool "Enable IRAM binary hot-path trace buffer"
        default y

    config ESP_FOC_TRACE_DEPTH
        int "Trace ring depth (power of two)"
        depends on ESP_FOC_TRACE_ENABLE
        range 16 4096
        default 256

    config ESP_FOC_ADC_DIGI_SW_TRIGGER
        bool "ADC digi software timer trigger (debug; disables ETM-only start)"
        default n
        help
            When enabled, the ADC digi controller timer starts conversions instead of
            relying solely on ETM ADC_TASK_START0. Use only for DMA bring-up HIL.

    config ESP_FOC_ENABLE_MOTOR_ID
        bool "Enable machine identification (sys-id + current-loop autotune)"
        default n
        help
            Adds the standstill/spin identification sequence and its estimator
            kernels. The FoC core does not depend on it, so leaving this off
            costs nothing.

    menu "Motor identification"
        depends on ESP_FOC_ENABLE_MOTOR_ID

        config ESP_FOC_MOTOR_ID_TASK_STACK
            int "Identification task stack (bytes)"
            range 3072 32768
            default 6144
            help
                The identification runs on its own task while the caller blocks,
                so the caller's stack does not have to hold the sequence. The
                on_event callback runs on this task: size it for what the
                callback does (a formatted log line with floats is the usual
                peak).

        config ESP_FOC_MOTOR_ID_TASK_PRIO
            int "Identification task priority"
            range 1 22
            default 5
            help
                Below the rotor task the sensored stages spawn at the top
                priority.

        config ESP_FOC_MOTOR_ID_PROBE_PERIODS
            int "Whole excitation periods per impedance probe"
            range 4 256
            default 128
            help
                Correlation window of the AC impedance probe. More periods trade
                identification time for noise rejection.

        config ESP_FOC_MOTOR_ID_I_TARGET_MA
            int "AC probe response target (mA)"
            range 50 5000
            default 450
            help
                The excitation amplitude is searched toward this response. High
                enough to be read over the current-sense floor.

        config ESP_FOC_MOTOR_ID_I_PROBE_MAX_MA
            int "AC probe response ceiling (mA)"
            range 100 10000
            default 900

        config ESP_FOC_MOTOR_ID_I_ABORT_MA
            int "Probe window abort average (mA)"
            range 100 20000
            default 1200
            help
                A probe window whose guard average reaches this is discarded.
                Keep it under the bridge trip so the identification names the
                state that failed before the trip latches.

        config ESP_FOC_MOTOR_ID_V_DEADZONE_MV
            int "Bridge dead zone the AC probes are biased past (mV)"
            range 0 5000
            default 700

        config ESP_FOC_MOTOR_ID_I_BW_HZ
            int "Current-loop bandwidth of the flux leg (Hz)"
            range 20 5000
            default 300

        config ESP_FOC_MOTOR_ID_I_FLUX_MA
            int "I-f current of the flux leg (mA)"
            range 50 10000
            default 450

        config ESP_FOC_MOTOR_ID_FLUX_HZ
            int "I-f electrical frequency of the flux leg (Hz)"
            range 10 2000
            default 100

        config ESP_FOC_MOTOR_ID_TRIES
            int "Attempts per electrical leg"
            range 1 10
            default 3

        menu "Sensored stages"

            config ESP_FOC_MOTOR_ID_FETCH_HZ
                int "Rotor fetch rate (Hz)"
                range 100 20000
                default 2500
                help
                    Rate the identification task reads the rotor at. Must divide
                    the PWM rate and match the rate the sensor was configured for.

            config ESP_FOC_MOTOR_ID_SPIN_I_BW_HZ
                int "Current-loop bandwidth while spinning on the encoder (Hz)"
                range 20 5000
                default 200

            config ESP_FOC_MOTOR_ID_IQ_DIR_MA
                int "+Iq of the direction check (mA)"
                range 50 10000
                default 700

            config ESP_FOC_MOTOR_ID_I_MAX_MA
                int "iq ceiling of the mechanical stage and speed hold (mA)"
                range 50 10000
                default 700

            config ESP_FOC_MOTOR_ID_K_FALLBACK
                int "K the speed hold falls back to (rad/s^2/A)"
                range 100 1000000
                default 6500
                help
                    Used only to design the internal speed hold when the raw
                    mechanical stage refuses its fit. Low on purpose: an
                    underestimated K gives a sluggish hold, an overestimated one
                    an unstable hold.

            config ESP_FOC_MOTOR_ID_ANGLE_COMP
                bool "Fit the Park-angle offset and latency on the encoder"
                default y

            config ESP_FOC_MOTOR_ID_OVERSPEED_HZ
                int "Abort above this electrical speed (Hz)"
                range 10 10000
                default 625

        endmenu

    endmenu

    menu "Phase map discovery"

        config ESP_FOC_PHASE_DISCOVER
            bool "Enable phase map discovery"
            default y
            help
                Standstill measurement of the PWM-to-phase permutation and the
                current-sense sign, plus encoder zero and direction when a
                rotor sensor is given. Values below are defaults for
                esp_foc_phase_discover_default_config() only.

        config ESP_FOC_PHASE_DISCOVER_VD_MV
            int "Probe voltage [mV]"
            depends on ESP_FOC_PHASE_DISCOVER
            range 200 12000
            default 1200
            help
                A voltage, not a bus fraction: dead time and device drop take
                a fixed ~0.7 V. Clamped to 5..25 % of Vdc at init.

        config ESP_FOC_PHASE_DISCOVER_ID_MIN_MA
            int "Minimum d-axis current to admit a candidate [mA]"
            depends on ESP_FOC_PHASE_DISCOVER
            range 10 2000
            default 80

        config ESP_FOC_PHASE_DISCOVER_PULSE_MS
            int "Pulse window [ms]"
            depends on ESP_FOC_PHASE_DISCOVER
            range 3 50
            default 6
            help
                Longer than the electrical time constant, shorter than the
                mechanical one.

        config ESP_FOC_PHASE_DISCOVER_CAL_ROUNDS
            int "Shunt zero rounds per candidate"
            depends on ESP_FOC_PHASE_DISCOVER
            range 0 256
            default 32

        config ESP_FOC_PHASE_DISCOVER_TRIES
            int "Attempts before giving up"
            depends on ESP_FOC_PHASE_DISCOVER
            range 1 8
            default 3

        config ESP_FOC_PHASE_DISCOVER_NUDGE_MS
            int "Nudge hold between attempts [ms]"
            depends on ESP_FOC_PHASE_DISCOVER
            range 0 5000
            default 300

        config ESP_FOC_PHASE_DISCOVER_SETTLE_MS
            int "Mechanical settle after a nudge [ms]"
            depends on ESP_FOC_PHASE_DISCOVER
            range 0 10000
            default 800

        menu "Rotor sensor stage"
            depends on ESP_FOC_PHASE_DISCOVER

            config ESP_FOC_PHASE_DISCOVER_WELL_MA
                int "Well hold current [mA]"
