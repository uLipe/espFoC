                default 500

            config ESP_FOC_PHASE_DISCOVER_STILL_TOL_MRAD
                int "Rest tolerance on the mechanical angle [mrad]"
                range 1 500
                default 12

            config ESP_FOC_PHASE_DISCOVER_STILL_CALM_MS
                int "Time inside the tolerance to call it rest [ms]"
