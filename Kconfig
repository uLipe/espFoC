    choice ESP_FOC_STACK
        prompt "FoC stack"
        default ESP_FOC_STACK_NONE
        help
            One closed-loop stack per build. Commissioning blocks (phase map,
            identification) and the building blocks stay available either way.

        config ESP_FOC_STACK_NONE
            bool "None (building blocks only)"

        config ESP_FOC_STACK_SENSORED
            bool "Sensored"

        config ESP_FOC_STACK_SENSORLESS
            bool "Sensorless"
    endchoice

