        menu "Guards"

            config ESP_FOC_SL_BEMF_PERMIL
                int "Abort when |e| under this fraction of psi*|w| [permil]"
                range 0 1000
                default 150

            config ESP_FOC_SL_BEMF_HOLD_MS
                int "BEMF guard hold [ms]"
                range 1 10000
                default 200

            config ESP_FOC_SL_BEMF_FMIN_HZ
                int "BEMF guard only above [Hz]"
                range 1 2000
                default 20

            config ESP_FOC_SL_OVERSPEED_PERMIL
                int "Overspeed, of fe_rated [permil]"
                range 100 5000
                default 1250

            config ESP_FOC_SL_OVERSPEED_HOLD_MS
                int "Overspeed hold [ms]"
                range 1 30000
                default 2000

            config ESP_FOC_SL_COLLAPSE_MA
                int "Current collapse under [mA]"
                range 1 50000
                default 60

            config ESP_FOC_SL_COLLAPSE_HOLD_MS
                int "Current collapse hold [ms]"
                range 1 10000
                default 250

            config ESP_FOC_SL_LOCK_LOSS_MS
                int "Observer lock loss hold [ms]"
                range 1 10000
                default 250

            config ESP_FOC_SL_LOCK_LOSS_ABORT
                bool "Abort on observer lock loss"
                default n
                help
                    Off in the baselines: the lock flag drops on healthy runs
                    and the BEMF guard covers a stalled rotor.

        endmenu

    endmenu

    config ESP_FOC_USE_HW_ACCEL_TRIGO
        bool "Use hardware CORDIC for trig when available"
        default n
        help
            When enabled and the SoC exposes a CORDIC accelerator, sin/cos/atan2/sqrt
            use hardware. Otherwise the software CORDIC path is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_IIR
        bool "Use hardware IIR for biquad when available"
        default n
        help
            When enabled and the SoC exposes an IIR/biquad accelerator, filter update
            uses hardware. Otherwise the software TDF-II path is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_PID
        bool "Use hardware PID (2p2z) when available"
        default n
        help
            When enabled and the SoC exposes a PID accelerator, pid update uses hardware.
            Otherwise the software 2p2z path is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_CLARKE
        bool "Use hardware Clarke transform when available"
        default n
        help
            When enabled and the SoC exposes a Clarke accelerator, clarke/inv_clarke
            use hardware. Otherwise the software path is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_PARK
        bool "Use hardware Park transform when available"
        default n
        help
            When enabled and the SoC exposes a Park accelerator, park/inv_park
            use hardware. Otherwise the software path is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_VLIM
        bool "Use hardware dq voltage limiter when available"
        default n
        help
            When enabled and the SoC exposes a voltage-limit accelerator, vlim uses
            hardware. Otherwise CORDIC sqrt + Q16 scale is used (all current targets).

    config ESP_FOC_USE_HW_ACCEL_SVM
        bool "Use hardware SVM when available"
        default n
        help
            When enabled and the SoC exposes an SVM accelerator, svm uses hardware.
            Otherwise min-max common-mode software SVM is used (all current targets).

endmenu
