<mxfile host="drawio"><diagram id="phase_discover_flow" name="phase_discover_flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c22" value="Sensor stage" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#808080;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontFamily=Helvetica;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="1110" width="970" height="105" as="geometry"/></mxCell><mxCell id="c4" value="Attempt" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#808080;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontFamily=Helvetica;fontColor=#404040;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="300" height="736" as="geometry"/></mxCell><mxCell id="c3" value="run()" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="120" y="0" width="100" height="24" as="geometry"/></mxCell><mxCell id="att" value="&lt;b&gt;Attempt n&lt;/b&gt; (n = 1 .. tries)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="44" as="geometry"/></mxCell><mxCell id="sa" value="&lt;b&gt;Stage A&lt;/b&gt;: 12 candidate maps&lt;br&gt;(6 orders &amp;times; 2 signs)&lt;br&gt;&amp;plusmn;V&lt;sub&gt;d&lt;/sub&gt; pulse pair at &amp;theta;&lt;sub&gt;e&lt;/sub&gt; = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="64" as="geometry"/></mxCell><mxCell id="rk"